# Makers injects these values into Cloud Functions. Edge Functions call the
# same-project /yuzu-edge control bridge and never receive the credentials.
EO_YUZU_CORE_ORIGIN=https://origin.example.com
EO_YUZU_EDGE_TOKEN=replace-with-core-edge-token
EO_YUZU_SIGNER_TOKEN=replace-with-independent-signer-token
EO_YUZU_BLOB_STORE=yuzu-media
